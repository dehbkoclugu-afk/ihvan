{
  "expo": {
    "name": "İhvan",
    "slug": "ihvan-quran",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ihvan",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "com.ihvan.quran",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ihvan.quran",
      "permissions": ["SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-mark.png",
        "backgroundColor": "#164B42"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-android-package-fix.js",
      "expo-router",
      "expo-font",
      "expo-asset",
      ["expo-localization", {
        "supportedLocales": {
          "ios": ["tr", "en", "ar"],
          "android": ["tr", "en", "ar"]
        }
      }],
      ["expo-location", {
        "locationWhenInUsePermission": "İhvan, bulunduğun yere göre namaz vakitlerini ve kıble yönünü hesaplamak için konumunu kullanır.",
        "locationAlwaysPermission": false,
        "locationAlwaysAndWhenInUsePermission": false,
        "isIosBackgroundLocationEnabled": false,
        "isAndroidBackgroundLocationEnabled": false,
        "isAndroidForegroundServiceEnabled": false
      }],
      ["expo-notifications", { "color": "#2D8C72", "icon": "./assets/notification-icon.png" }],
      ["expo-splash-screen", { "backgroundColor": "#164B42", "image": "./assets/brand-mark.png", "imageWidth": 180 }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
